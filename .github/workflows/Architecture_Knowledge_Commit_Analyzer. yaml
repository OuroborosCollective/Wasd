```yaml
name: Architecture Knowledge & Commit Analyzer

on:
  push:
    branches:
      - main
  workflow_dispatch:
    inputs:
      analyze_history:
        description: 'Setze auf "true", um ALLE bisherigen Commits rückwirkend zu analysieren (Vorsicht: API Kosten)'
        required: false
        default: 'false'

permissions:
  contents: write # Erlaubt dem Bot, die generierten JSON-Dateien in den Repo-Ordner zu pushen

jobs:
  analyze-commits:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Repository (Full History)
        uses: actions/checkout@v4
        with:
          fetch-depth: 0 # Wichtig für die Historie und Diffs

      - name: Setup Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'

      - name: Install Dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r .github/scripts/requirements.txt

      - name: Run LLM Commit Analysis
        env:
          # Du musst diesen API Key in den GitHub Repository Secrets hinterlegen!
          # Gehe zu: Settings -> Secrets and variables -> Actions -> New repository secret
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }} 
          ANALYZE_HISTORY: ${{ github.event.inputs.analyze_history }}
        run: |
          python .github/scripts/analyze_commits.py

      - name: Commit and Push Knowledge Base Updates
        uses: stefanzweifel/git-auto-commit-action@v5
        with:
          commit_message: "chore(llm): update semantic architecture knowledge base [skip ci]"
          branch: main
          file_pattern: 'llm_knowledge_base/**/*.json'

```

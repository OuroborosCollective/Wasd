name: MMORPG Smart CI v5

on:
  push:
    branches: [ "main" ]
  pull_request:

permissions:
  contents: read

jobs:
  detect-changes:
    runs-on: ubuntu-latest
    outputs:
      api: ${{ steps.filter.outputs.api }}
      web: ${{ steps.filter.outputs.web }}
    steps:
      - uses: actions/checkout@v4.2.2

      - name: Detect changed paths
        uses: dorny/paths-filter@v3
        id: filter
        with:
          filters: |
            api:
              - 'apps/api/**'
              - 'packages/**'
            web:
              - 'apps/web/**'
              - 'packages/**'

  build:
    needs: detect-changes
    runs-on: ubuntu-latest

    strategy:
      matrix:
        include:
          - app: api
            run: ${{ needs.detect-changes.outputs.api }}
          - app: web
            run: ${{ needs.detect-changes.outputs.web }}

    if: matrix.run == 'true'

    services:
      postgres:
        image: postgres:15
        env:
          POSTGRES_USER: postgres
          POSTGRES_PASSWORD: password
          POSTGRES_DB: game
        ports:
          - 5432:5432

    steps:
      - uses: actions/checkout@v4.2.2

      - uses: pnpm/action-setup@v2
        with:
          version: 9

      - uses: actions/setup-node@v4.2.0
        with:
          node-version: 20
          cache: pnpm

      # 🔥 Turbo Cache für Monorepo
      - name: Restore Turbo Cache
        uses: actions/cache@v4
        with:
          path: |
            .turbo
            node_modules/.cache
          key: turbo-${{ runner.os }}-${{ github.sha }}
          restore-keys: |
            turbo-${{ runner.os }}-

      - name: Install deps
        run: pnpm install --frozen-lockfile

      - name: Build (Turbo Smart)
        run: pnpm turbo run build --filter=apps/${{ matrix.app }}...

      - name: Test
        run: pnpm turbo run test --filter=apps/${{ matrix.app }}...
        env:
          DATABASE_URL: postgresql://postgres:password@localhost:5432/game

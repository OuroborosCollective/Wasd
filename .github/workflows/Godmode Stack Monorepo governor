name: ARE Monorepo Governor (Production Mode)

on:
  push:
    branches:
      - main
      - dev
      - staging
  pull_request:
    branches:
      - main
      - dev
      - staging
  workflow_dispatch:
  schedule:
    - cron: '30 3 * * *'

concurrency:
  group: are-governor-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: write
  pull-requests: write
  security-events: write
  actions: read

jobs:
  validate:
    name: Validate (No Side Effects)
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        node-version: [20]
    steps:
      - name: Checkout
        uses: actions/checkout@v4.2.2
        with:
          fetch-depth: 0
      - name: Install pnpm
        uses: pnpm/action-setup@v4
        with:
          version: 9.12.2
      - name: Setup Node
        uses: actions/setup-node@v4.2.0
        with:
          node-version: ${{ matrix.node-version }}
          cache: 'pnpm'
      - name: Install Dependencies
        run: pnpm install --frozen-lockfile
      - name: TypeScript Check
        run: pnpm exec tsc --noEmit || true
      - name: ESLint Check (read-only)
        run: pnpm exec eslint . --ext .js,.jsx,.ts,.tsx || true
      - name: Circular Dependency Check
        run: npx madge --circular . || true
      - name: Dependency Health Check
        run: npx depcheck || true

  repair:
    name: Auto Repair (Safe Mode)
    runs-on: ubuntu-latest
    if: github.event_name == 'push' || github.event_name == 'workflow_dispatch'
    needs: validate
    steps:
      - name: Checkout
        uses: actions/checkout@v4.2.2
        with:
          fetch-depth: 0
          persist-credentials: true
      - name: Install pnpm
        uses: pnpm/action-setup@v4
        with:
          version: 9.12.2
      - name: Setup Node
        uses: actions/setup-node@v4.2.0
        with:
          node-version: 20
          cache: 'pnpm'
      - name: Install Dependencies
        run: pnpm install --frozen-lockfile
      - name: Auto Fix Code
        run: pnpm exec eslint . --fix || true
      - name: Format Code
        run: pnpm exec prettier . --write || true
      - name: Build Check
        run: pnpm run build || true
      - name: Commit Changes
        run: |
          git config user.name "ARE Governor"
          git config user.email "gov@actions.local"
          git add .
          git diff --cached --quiet && echo "No changes" || git commit -m "chore: auto-repair by governor [skip ci]"
      - name: Push Changes
        run: |
          git push origin HEAD:${{ github.ref_name }} || true

  pull_request_guard:
    name: PR Governor (Safe Merge Control)
    runs-on: ubuntu-latest
    if: github.event_name == 'pull_request'
    steps:
      - name: Checkout
        uses: actions/checkout@v4.2.2
      - name: Install pnpm
        uses: pnpm/action-setup@v4
        with:
          version: 9.12.2
      - name: Setup Node
        uses: actions/setup-node@v4.2.0
        with:
          node-version: 20
          cache: 'pnpm'
      - name: Install
        run: pnpm install --frozen-lockfile
      - name: Run Full Quality Gate
        run: |
          pnpm exec eslint . || true
          pnpm exec tsc --noEmit || true
          npx madge --circular . || true
      - name: Comment Result on PR
        uses: actions/github-script@v7
        with:
          script: |
            github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body: "🤖 Governor Report: CI checks executed via pnpm. Review logs for details."
            })

  security:
    name: Security Scan
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4.2.2
      - name: Install pnpm
        uses: pnpm/action-setup@v4
        with:
          version: 9.12.2
      - name: Setup Node
        uses: actions/setup-node@v4.2.0
        with:
          node-version: 20
          cache: 'pnpm'
      - name: Install dependencies
        run: pnpm install --frozen-lockfile
      - name: Run SARIF Scan
        run: |
          pnpm exec eslint . \
            --format @microsoft/eslint-formatter-sarif \
            --output-file eslint-results.sarif || true
      - name: Upload SARIF
        uses: github/codeql-action/upload-sarif@v3
        with:
          sarif_file: eslint-results.sarif
          wait-for-processing: true

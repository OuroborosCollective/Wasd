{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "types": ["node", "vitest"],
    "allowJs": false,
    "composite": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@wasd/shared": ["../packages/shared/src/index.ts"],
      "@wasd/shared/*": ["../packages/shared/src/*"]
    }
  },
  "include": [
    "src",
    "../packages/shared/src/**/*.ts",
    "../packages/shared/src/**/*.tsx",
    "../server/src/modules/economy/ScarcityPredictor.ts",
    "../server/src/events/WorldEventBus.ts",
    "../server/src/modules/history/WorldHistory.ts",
    "../server/src/theme/serverThemeHazard.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}

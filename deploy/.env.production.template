# =============================================================================
# Areloria / Ouroboros — PRODUCTION .env template (VPS: /opt/areloria/.env)
# =============================================================================
# 1) Kopiere diese Datei auf den Server (niemals ins Git committen):
#    Von deinem PC:  scp deploy/.env.production.template user@DEIN_SERVER:/opt/areloria/.env
# 2) Auf dem Server:  nano /opt/areloria/.env   → Werte ausfüllen
# 3) Neustart:        pm2 restart areloria
# Prüfen:              curl -s http://127.0.0.1:3000/health | head -c 2000
# =============================================================================

# --- Kern ---
NODE_ENV=production
PORT=3000

# Pfade (Standard unter /opt/areloria — nur ändern wenn dein Install anders ist)
CLIENT_ROOT_DIR=/opt/areloria/client
# WORLD_ASSETS_DIR=/opt/areloria/world-assets

# --- Öffentliche URLs (Client / Browser) ---
PUBLIC_WEBSOCKET_URL=wss://DEINE-DOMAIN/ws
# NEXT_PUBLIC_WEBSOCKET_URL=   # nur falls du Next/anderes Frontend nutzt

# --- Runtime API / CORS Security ---
# API_KEY oder API_KEYS schützen serverseitige Admin-/World-API-Routen.
# API_KEYS kann mehrere Schlüssel per Komma enthalten.
API_KEY=CHANGE_ME_LONG_RANDOM_SECRET
# API_KEYS=CHANGE_ME_KEY_1,CHANGE_ME_KEY_2

# Erlaubte Browser-Ursprünge für Socket.io/CORS in Production.
ALLOWED_ORIGINS=https://areloria.de,https://www.areloria.de
# CORS_ORIGINS=https://areloria.de,https://www.areloria.de

# --- Client Auth (VITE_* werden beim BUILD des Clients eingebettet — in .env am Repo-Root vor pnpm build setzen) ---
# Auf dem VPS: vor deploy/build dieselben Werte in die .env legen, die `pnpm run build` liest (meist Repo-Root .env).
# VITE_AUTH_PROVIDER=***
# VITE_SUPABASE_URL=https://supabase.example.com
# VITE_SUPABASE_PUBLIC_URL=https://supabase.example.com
# VITE_SUPABASE_ANON_KEY=

# --- Supabase Server Auth (empfohlen) ---
# SUPABASE_URL=https://supabase.example.com
# SUPABASE_PUBLIC_URL=https://supabase.example.com
# SUPABASE_PROXY_URL=http://127.0.0.1:8000    # server-side internal URL — use HTTP for same-VPS Supabase (avoids self-signed cert)
# GAME_ORIGIN=https://arelogic.space            # browser client URL (set when using SUPABASE_PROXY_URL)
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=CHANGE...CRET

# --- WebSocket Login ---
# 1 = JWT auf Login prüfen (pro Provider)
USE_SUPABASE_WS_LOGIN=1
ALLOW_GUEST_LOGIN=1
ALLOW_DEV_LOGIN=0
# REQUIRE_SUPABASE_AUTH=***

# --- Sicherheit / Secrets (selbst erfinden: lange Zufallszeichen) ---
JWT_SECRET=ÄNDERE...LLIG
ADMIN_PANEL_TOKEN=ÄNDERE...LLIG
PLAYTESTER_MONITOR_TOKEN=ÄNDERE...LLIG

# --- Manifest System (Server Authority) ---
# Secret für HMAC-SHA256 Signatur der Tick-Manifeste
# Generieren: openssl rand -hex 64
MANIFEST_AUTHORITY_SECRET=ÄNDERE...LLIG
# Welt-ID für Manifest-Identifikation
WORLD_ID=areloria-main

# --- Playtester Monitor (WebRTC stream default) ---
PLAYTESTER_ENABLED=true
PLAYTESTER_MONITOR_MODE=webrtc
PLAYTESTER_STREAM_WIDTH=640
PLAYTESTER_STREAM_HEIGHT=360
PLAYTESTER_STREAM_FPS=15
PLAYTESTER_STREAM_QUALITY=low
PLAYTESTER_STREAM_SHADOWS=false
PLAYTESTER_STREAM_PARTICLES=false
PLAYTESTER_STREAM_RENDER_DISTANCE=small
# Optional custom STUN/TURN (comma-separated), fallback is Google STUN:
# PLAYTESTER_WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302

# --- Datenbank (Supabase/Postgres) ---
# Bevorzugt:
# DATABASE_URL=postgresql://postgres:***@127.0.0.1:5432/postgres
# Oder Einzelwerte:
# PGHOST=
# PGPORT=5432
# PGDATABASE=postgres
# PGUSER=postgres
# PGPASSWORD=*** PGSSL=true

# --- Persistenz ---
# auto = Postgres -> file
# PERSISTENCE_DRIVER=auto
# PERSISTENCE_DRIVER=postgres
# PLAYER_SAVE_FILE=/opt/areloria/data/players.json

# --- Quest Persistence ---
# Quest state persistence file path (JSON)
# Container path: /app/data/quest-state.json
# Mount: - /opt/areloria/data:/app/data (in docker-compose.prod.yml)
# Default: process.cwd()/data/quest-state.json
# QUEST_STATE_FILE=/app/data/quest-state.json

# --- Admin / Content API ---
# CONTENT_ADMIN_READONLY=0
# MAX_ADMIN_GLB_UPLOAD_MB=50

# --- MCP (optional) ---
# MCP_ADMIN_TOKEN=*** MCP_PUBLIC_SSE_URL=
# MCP_PUBLIC_MESSAGES_URL=

# --- GitHub Actions (nur in GitHub Repo Secrets — NICHT hier für Runtime) ---
# DEPLOY_VERIFY_BASE_URL=https://deine-domain.tld
# VPS_IP=  VPS_USER=  VPS_SSH_PASSWORD=***

FROM node:22.23.2-alpine AS base

# Install SSH and build dependencies
RUN apk add --no-cache openssh-client sshpass openssl

# Install pnpm and corepack via npm (more reliable in alpine)
RUN npm install -g pnpm@9 && corepack enable

WORKDIR /app

FROM base AS builder
WORKDIR /app

# Copy workspace files
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/ packages/
COPY apps/ apps/
COPY projects/ projects/
COPY server/package.json server/package.json
COPY client/package.json client/package.json
COPY engine/package.json engine/package.json
COPY portal/package.json portal/package.json

RUN find packages apps projects -type f ! -name 'package.json' -delete 2>/dev/null; \
    find packages apps projects -type d -empty -delete 2>/dev/null; \
    true

# Install dependencies (limit Node heap to avoid OOM on small VPS instances)
ENV NODE_OPTIONS="--max-old-space-size=1024"
RUN pnpm install --frozen-lockfile

# Copy source and build
COPY . .
ENV NODE_ENV=production
RUN pnpm build

# Deploy server package
RUN pnpm --filter @wasd/server deploy /app/prod-server

# Production runner stage
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000

# Copy deployed application
COPY --from=builder /app/prod-server ./

# Security: non-root by default in alpine
USER node

EXPOSE 3000

# Healthcheck for SSH-based validation
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD node -e "const http=require('http');http.get('http://localhost:3000/health',(r)=>{process.exit(r.statusCode===200?0:1)}).on('error',()=>process.exit(1))"

CMD ["node", "dist/index.js"]
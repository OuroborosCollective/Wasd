# Multi-stage Production Dockerfile
FROM node:22-alpine AS builder

WORKDIR /app

# Enable pnpm
RUN corepack enable && corepack prepare pnpm@9.12.2 --activate

# Copy only manifests for better caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
# Copy all package.json files to allow pnpm install to work correctly
COPY apps/api/package.json ./apps/api/
COPY apps/client-2d/package.json ./apps/client-2d/
COPY apps/web/package.json ./apps/web/
COPY packages/backend/package.json ./packages/backend/
COPY packages/core-ecs/package.json ./packages/core-ecs/
COPY packages/core-logic/package.json ./packages/core-logic/
COPY packages/core-network/package.json ./packages/core-network/
COPY packages/core/package.json ./packages/core/
COPY packages/database/package.json ./packages/database/
COPY packages/logger/package.json ./packages/logger/
COPY packages/redis/package.json ./packages/redis/
COPY packages/rendering-bridge/package.json ./packages/rendering-bridge/
COPY packages/shared/package.json ./packages/shared/
COPY packages/spatial-hub/package.json ./packages/spatial-hub/
COPY packages/types/package.json ./packages/types/
COPY packages/ui/package.json ./packages/ui/
COPY packages/utils/package.json ./packages/utils/
COPY projects/ads/package.json ./projects/ads/
COPY projects/agri-sim/package.json ./projects/agri-sim/
COPY projects/api/package.json ./projects/api/
COPY projects/arena/package.json ./projects/arena/
COPY projects/card-logic/package.json ./projects/card-logic/
COPY projects/crypto-pulse/package.json ./projects/crypto-pulse/
COPY projects/eco-trader/package.json ./projects/eco-trader/
COPY projects/edu-sim/package.json ./projects/edu-sim/
COPY projects/logi-link/package.json ./projects/logi-link/
COPY projects/logic-grid/package.json ./projects/logic-grid/
COPY projects/logistics/package.json ./projects/logistics/
COPY projects/ouro-api/package.json ./projects/ouro-api/
COPY projects/retail-opt/package.json ./projects/retail-opt/
COPY projects/social-sim/package.json ./projects/social-sim/
COPY projects/social/package.json ./projects/social/
COPY projects/story/package.json ./projects/story/
COPY projects/urban-flow/package.json ./projects/urban-flow/
COPY projects/urban/package.json ./projects/urban/
COPY client/package.json ./client/
COPY engine/package.json ./engine/
COPY portal/package.json ./portal/
COPY server/package.json ./server/

# Install all dependencies (including dev for build)
RUN pnpm install --frozen-lockfile

# Copy source code
COPY . .

# Build the project
# Standardizing on running the build - if it fails here, the Docker build fails.
RUN pnpm run build

# Production stage
FROM node:22-alpine AS runner

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.12.2 --activate

# Copy necessary files for production
COPY --from=builder /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml /app/.npmrc ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/server/dist ./server/dist
COPY --from=builder /app/server/package.json ./server/package.json
# Add any other required packages/dist folders if server depends on them at runtime
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/packages/shared/package.json ./packages/shared/package.json

ENV NODE_ENV=production PORT=3000
EXPOSE 3000

# Use node to run the compiled server
CMD ["node", "server/dist/index.js"]

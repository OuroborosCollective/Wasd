# Production Dockerfile - Full monorepo build using Teleport pattern
FROM node:22-alpine AS manifests
WORKDIR /tmp
COPY . .
RUN mkdir -p /tmp/manifests && \
    find . -name "package.json" -mindepth 1 -maxdepth 4 \
    ! -path "*/node_modules/*" \
    ! -path "*/dist/*" \
    -exec sh -c 'mkdir -p /tmp/manifests/$(dirname {}) && cp {} /tmp/manifests/{}' \;

FROM node:22-alpine AS builder
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.12.2 --activate

# Copy manifests and lockfile for caching
COPY --from=manifests /tmp/manifests/ ./
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./

# Install deps (cached layer)
RUN apk add --no-cache python3 make g++ && \
    pnpm install --frozen-lockfile --loglevel info

# Copy source code
COPY . .

# Build shared package first (required by server), then server
ENV NODE_ENV=production
RUN pnpm --filter @wasd/shared build && \
    pnpm --filter @wasd/server build

# Runner
FROM node:22-alpine AS runner
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.12.2 --activate

# Copy built artifacts
COPY --from=builder /app/server/dist ./server/dist
COPY --from=builder /app/server/node_modules ./server/node_modules
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/packages/shared/package.json ./packages/shared/package.json

ENV NODE_ENV=production PORT=3000
EXPOSE 3000
USER node

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD node -e "fetch('http://localhost:3000/health').then(r => r.ok ? process.exit(0) : process.exit(1)).catch(() => process.exit(1))"

CMD ["node", "server/dist/index.js"]

# Production Dockerfile - Optimized monorepo build
FROM node:22-alpine AS base

# Install pnpm and corepack
RUN corepack enable && corepack prepare pnpm@9.12.2 --activate

# Stage 1: Build the application
FROM base AS builder
WORKDIR /app

# Copy essential workspace files
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.json tsconfig.base.json ./

# Copy individual package.json files for better caching
COPY packages/*/package.json packages/
COPY apps/*/package.json apps/
COPY projects/*/package.json projects/
COPY server/package.json server/
COPY client/package.json client/
COPY engine/package.json engine/
COPY portal/package.json portal/

# Install dependencies
RUN apk add --no-cache python3 make g++
RUN pnpm install --frozen-lockfile

# Copy the rest of the source code
COPY . .

# Build the monorepo
ENV NODE_ENV=production
RUN pnpm build

# Use pnpm deploy to isolate the server package for runtime
RUN pnpm --filter @wasd/server deploy /app/prod-server

# Stage 2: Production runner
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

# Copy the deployed package from the builder stage
COPY --from=builder /app/prod-server ./

# Ensure correct permissions
RUN chown -R node:node /app
USER node

EXPOSE 3000

# Modernized healthcheck using top-level await fetch
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD node --input-type=module -e "try { const r = await fetch('http://localhost:3000/health'); process.exit(r.ok ? 0 : 1); } catch { process.exit(1); }"

CMD ["node", "dist/index.js"]

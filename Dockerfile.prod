# Production Dockerfile - Full monorepo build
FROM node:22-alpine AS builder

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.12.2 --activate

# Copy ALL workspace files needed for build
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.json tsconfig.base.json ./
COPY packages packages/
COPY apps apps/
COPY server server/
COPY backend backend/
COPY client client/

# Install deps first (cached layer)
RUN apk add --no-cache python3
RUN pnpm install --frozen-lockfile

# Install tsx with -w flag for workspace
RUN pnpm add -w -D tsx

# Build step (continue even with errors)  
RUN pnpm build || true

# Runner
FROM node:22-alpine AS runner
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.12.2 --activate

# Copy built dist from builder (builder already ran pnpm build || true)
COPY --from=builder /app/server/dist ./server/dist
COPY --from=builder /app/server/node_modules ./server/node_modules
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/packages/shared/package.json ./packages/shared/package.json

ENV NODE_ENV=production PORT=3000
EXPOSE 3000
USER node

CMD ["node", "server/dist/index.js"]

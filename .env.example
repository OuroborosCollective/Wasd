PORT=3000
NODE_ENV=development

# Optional: absolute path to the `client` package when the server runs outside the monorepo root
# (e.g. PM2 cwd is /opt/server only). Example: /opt/areloria/client
# CLIENT_ROOT_DIR=
# Optional: absolute path to repo-root `world-assets/` when PM2 cwd is not the monorepo (serves /world-assets/*)
# WORLD_ASSETS_DIR=/opt/areloria/world-assets
# Optional: client mirror from sync-world-assets (serves /world-assets/* when WORLD_ASSETS_DIR unset)
# MIRRORED_WORLD_ASSETS_DIR=/opt/areloria/client/public/assets/models/world-assets
MCP_ADMIN_TOKEN=12|MCP.../sse
MCP_PUBLIC_MESSAGES_URL=https://your-domain.example/api/mcp/messages?sessionId=<id>
PUBLIC_WEBSOCKET_URL=wss://your-domain.example/ws

# --- GitHub Actions (not read by Node): set in repo Secrets ---
# DEPLOY_VERIFY_BASE_URL=https://your-public-game-domain.tld   # optional; enables HTTPS checks after VPS deploy
# VPS_IP=  VPS_USER=  VPS_SSH_PASSWORD=***

# Supabase (optional auth provider + Postgres stack)
# SUPABASE_URL=https://your-supabase-domain.example
# SUPABASE_PUBLIC_URL=https://your-supabase-domain.example
# SUPABASE_PROXY_URL=http://your-kong-host:8000  # server-side internal URL for /auth/v1 proxy (bypasses TLS issues)
# GAME_ORIGIN=https://your-game.example.com       # browser client URL when using SUPABASE_PROXY_URL (auto-derived from APP_ORIGIN if unset)
# Self-hosted docker stacks often use these names — the server accepts them as aliases:
# API_EXTERNAL_URL=http://your-kong-host:8000   # also used for /auth/v1 proxy base when SUPABASE_URL unset
# ANON_KEY=eyJ...
# SERVICE_ROLE_KEY=eyJ...
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# For server-side JWT verification of Supabase access tokens (must match GoTrue signing secret):
# SUPABASE_JWT_SECRET=your-s...cret
# Fallbacks (first non-empty wins): JWT_SECRET, GOTRUE_JWT_SECRET, AUTH_JWT_SECRET, SECRET_KEY_BASE (self-hosted)
# JWT_SECRET=***

# When Supabase Admin is unset, players are saved to JSON (default: <repo>/data/players.json)
# PLAYER_SAVE_FILE=/var/lib/areloria/players.json

# Persistence: auto (Postgres if DATABASE_URL/PG* configured, else file)
# Supported: auto | postgres | file
# postgres = PostgreSQL/Supabase via DATABASE_URL (run migrations/ SQL first)
# PERSISTENCE_DRIVER=auto
# DATABASE_URL=postgresql://postgres:***@127.0.0.1:5432/postgres
# (alternatives accepted by Database.ts: SUPABASE_DB_URL or PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD)
# If you only have docker-style vars, set e.g. POSTGRES_HOST=db POSTGRES_PASSWORD=*** (POSTGRES_USER defaults to postgres).
# Remote pooler (Supavisor): set POSTGRES_HOST to the pooler hostname; if POSTGRES_PORT is unset, POOLER_PROXY_PORT_TRANSACTION (e.g. 6543) is used when host is not db/localhost.
# Force-disable TLS for pg (docker internal db): DATABASE_SSL_DISABLED=1 or PGSSLMODE=disable
# DATABASE_SSL=true
# GLB link overrides: default = JSON file game-data/glb-links.json (content root)
# GLB_LINKS_STORE=file

# WebSocket login: production requires Supabase token unless guest mode is on
# ALLOW_GUEST_LOGIN=1
# In development, socket-id dev login is allowed unless disabled:
# ALLOW_DEV_LOGIN=0
# Strict: only Supabase tokens (no guest / no dev fallback). Fails fast if Admin key missing.
# REQUIRE_SUPABASE_AUTH=***
# Supabase auth toggles:
# USE_SUPABASE_WS_LOGIN=1

# --- Client (Vite) Supabase config ---
# VITE_AUTH_PROVIDER=***          # supabase | none (auto if unset)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLIC_URL=
# VITE_SUPABASE_ANON_KEY=
# If the client is built without Vite env (production bundle), the game server serves
# GET /client-config.json with supabaseUrl + supabaseAnonKey from server env (VITE_* or API_EXTERNAL_URL + ANON_KEY).
# Force provider selection (optional): supabase | none
# VITE_AUTH_PROVIDER=***

# Optional: local server self-healing engine (no external APIs)
# SELF_HEAL_ENABLED=1
# SELF_HEAL_PATCH_MODE=auto           # auto | log-only
# SELF_HEAL_VERBOSE=1
# SELF_HEAL_STORAGE_DIR=.selfhealing  # absolute or repo-relative path
# SELF_HEAL_COOLDOWN_MS=5000
# SELF_HEAL_MAX_ATTEMPTS=3
# SELF_HEAL_WATCHDOG_INTERVAL_MS=30000
# Optional read-only dashboard API:
# SELF_HEAL_DASHBOARD_ENABLED=1
# SELF_HEAL_DASHBOARD_PREFIX=/selfhealing
# SELF_HEAL_DASHBOARD_CORS=1
# SELF_HEAL_DASHBOARD_ALLOWED_ORIGIN=*

# Optional: stricter per-account WS message cap (rolling 1s window, after login)
# WS_MAX_MESSAGES_PER_PLAYER_UID_PER_SECOND=48

# Optional: ms between entity_sync for clients that send login.clientHints.lowBandwidth (default 400 in GameConfig)
# STATE_BROADCAST_INTERVAL_MOBILE_MS=500

# Optional: load game content from `published-content/current/` (after `pnpm run content:publish`) instead of `game-data/`
# USE_PUBLISHED_CONTENT=1
# Or set absolute path to a pack folder that contains content-pack-manifest.json + same layout as game-data/
# CONTENT_PACK_DIR=/var/lib/areloria/content/current

# No-code content admin (GLB-Links + asset-pools.json) — REST under /api/admin/content
# UI: /admin-content.html (static). ADMIN_PANEL_TOKEN=*** secret you invent (long random string, like an API key; do not commit).
# ADMIN_PANEL_TOKEN=***
# Block all writes (GET still works): CONTENT_ADMIN_READONLY=1
# Admin API also exposes: GET .../choices, GET .../glb-gallery-tree, POST .../glb-upload (multipart file + optional folder), POST .../validate-preview, POST .../publish-pack
# Optional: cap admin GLB upload size in MB (default 50, max 120); falls back to MAX_GLB_SIZE_MB if unset
# MAX_ADMIN_GLB_UPLOAD_MB=50

# WebSocket URL for client hints (production: wss://your-domain/ws)
PUBLIC_WEBSOCKET_URL=ws://localhost:3000/ws
# Legacy / other stacks only:
# NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:3000/ws

# No-code admin — long random secret
ADMIN_PANEL_TOKEN=***

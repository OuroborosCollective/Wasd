PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=password
DB_NAME=app_db
DATABASE_URL=postgresql://admin:password@localhost:5432/app_db

# Redis Configuration (Caching/Queue)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_change_me
JWT_EXPIRATION=24h
BCRYPT_SALT_ROUNDS=12

# Mail / SMTP Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM_ADDRESS=noreply@yourdomain.com
SMTP_FROM_NAME=AppNotification

# External API Keys
EXTERNAL_SERVICE_API_KEY=your_api_key_here
THIRD_PARTY_SERVICE_URL=https://api.external.com

# Object Storage (e.g., AWS S3 / Minio)
STORAGE_DRIVER=s3
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=eu-central-1
AWS_S3_BUCKET=your_app_bucket_name
AWS_S3_ENDPOINT=

# Frontend / CORS Configuration
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Logging & Monitoring
LOG_LEVEL=debug
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
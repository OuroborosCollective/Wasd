PORT=3000
AI_SERVICE_PORT=3001
WORKER_PORT=3002
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=password
DB_NAME=app_db
DATABASE_URL=postgresql://admin:password@localhost:5432/app_db

# Supabase Credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Redis Configuration (Caching/Queue/PubSub)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=app_cache:
REDIS_TLS=false
REDIS_RETRY_STRATEGY=true

# AI Agent Provider Keys
OPENAI_API_KEY=sk-proj-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-key
MISTRAL_API_KEY=your-mistral-key
HUGGINGFACE_API_TOKEN=hf_your_token
COHERE_API_KEY=your-cohere-key
PERPLEXITY_API_KEY=your-perplexity-key

# AI Configuration Defaults
AI_DEFAULT_MODEL=gpt-4o
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_change_me
JWT_EXPIRATION=24h
BCRYPT_SALT_ROUNDS=12

# Mail / SMTP Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM_ADDRESS=noreply@yourdomain.com
SMTP_FROM_NAME=AppNotification

# External API Keys
EXTERNAL_SERVICE_API_KEY=your_api_key_here
THIRD_PARTY_SERVICE_URL=https://api.external.com

# Object Storage (e.g., AWS S3 / Minio)
STORAGE_DRIVER=s3
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=eu-central-1
AWS_S3_BUCKET=your_app_bucket_name
AWS_S3_ENDPOINT=

# Frontend / CORS Configuration
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Logging & Monitoring
LOG_LEVEL=debug
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
PORT=3000
AI_SERVICE_PORT=3001
WORKER_PORT=3002
NODE_ENV=development

# Database Configuration (Prisma)
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=password
DB_NAME=areloria_db
# Main connection string (used by Prisma)
DATABASE_URL=postgresql://admin:password@localhost:5432/areloria_db?schema=public
# Direct connection string for migrations (useful for Supabase/connection poolers)
DIRECT_URL=postgresql://admin:password@localhost:5432/areloria_db?schema=public

# Supabase Credentials (Authentication & Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Redis Configuration (Caching/Queue/PubSub for Game State)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=areloria:
REDIS_TLS=false
REDIS_RETRY_STRATEGY=true

# AI Agent Provider Keys (Jules Agent Core)
OPENAI_API_KEY=sk-proj-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-key
MISTRAL_API_KEY=your-mistral-key
HUGGINGFACE_API_TOKEN=hf_your_token
COHERE_API_KEY=your-cohere-key
PERPLEXITY_API_KEY=your-perplexity-key

# AI Configuration & Scoring Defaults
AI_DEFAULT_MODEL=gpt-4o
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
AI_SERVICE_URL=http://localhost:3001
SCORING_THRESHOLD=0.85

# Jules Agent System
JULES_AGENT_ID=jules-core-001
JULES_AUTONOMY_LEVEL=high
JULES_MEMORY_TTL=3600

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_change_me
JWT_EXPIRATION=24h
BCRYPT_SALT_ROUNDS=12
INTERNAL_SERVICE_SECRET=your_internal_shared_secret_for_microservices

# Manifest System (Server Authority)
# Secret for HMAC-SHA256 signing of tick manifests
# Generate with: openssl rand -hex 64
MANIFEST_AUTHORITY_SECRET=your_manifest_authority_secret_change_me
# World ID for manifest identification
WORLD_ID=areloria-dev

# Mail / SMTP Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM_ADDRESS=noreply@areloria.com
SMTP_FROM_NAME=AreloriaWASD

# Object Storage (AWS S3 / Minio / Supabase Storage)
STORAGE_DRIVER=s3
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=eu-central-1
AWS_S3_BUCKET=areloria-assets
AWS_S3_ENDPOINT=
NEXT_PUBLIC_ASSET_URL=https://cdn.areloria.com

# Frontend / CORS Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Logging & Monitoring
LOG_LEVEL=debug
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=
ANALYTICS_ENABLED=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# World Editor & Game Engine Flags
NEXT_PUBLIC_WORLD_EDITOR_ENABLED=true
NEXT_PUBLIC_DEBUG_MODE=true
MAX_PLAYERS_PER_INSTANCE=32
TICK_RATE_MS=50

# CI/CD & Build Flags
SKIP_ENV_VALIDATION=false
CI=false
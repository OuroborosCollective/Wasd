{
  "name": "@wasd/client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ../scripts/write-public-route-hub.mjs",
    "build:itch": "tsc && vite build --mode itch",
    "app:build": "vite build && npx cap sync android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "core-network:build": "pnpm --filter @arelorian/core-network build",
    "core-network:dev": "pnpm --filter @arelorian/core-network dev"
  },
  "dependencies": {
    "@babylonjs/core": "9.17.0",
    "@babylonjs/havok": "^1.3.13",
    "@babylonjs/loaders": "9.17.0",
    "@babylonjs/materials": "9.17.0",
    "@preact/signals-core": "^1.14.4",
    "@react-three/fiber": "^9.6.1",
    "@react-three/xr": "^6.6.30",
    "@supabase/supabase-js": "^2.110.7",
    "@wasd/shared": "workspace:*",
    "firebase": "^12.16.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.25.0",
    "mobx": "^6.15.4",
    "mobx-react-lite": "^4.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "socket.io-client": "^4.8.3",
    "three": "0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/socket.io-client": "^3.0.0",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.0",
    "postcss": "^8.5.19",
    "tailwindcss": "4",
    "typescript": "^5.8.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.8"
  }
}

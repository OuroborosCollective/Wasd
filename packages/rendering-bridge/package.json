{
  "name": "@wasd/rendering-bridge",
  "version": "1.0.0",
  "description": "Bridge for rendering interoperability between Babylon.js and Three.js",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts",
    "lint": "eslint src/**/*.ts",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "babylonjs": "^6.0.0",
    "three": ">=0.150.0"
  },
  "devDependencies": {
    "babylonjs": "^6.48.1",
    "three": "^0.162.0",
    "typescript": "^5.4.2",
    "tsup": "^8.0.2",
    "rimraf": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
{
  "name": "@wasd/core-ecs",
  "version": "0.1.0",
  "description": "Engine-agnostic Entity Component System for the WASD monorepo",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts",
    "build": "tsup src/index.ts --format cjs,esm --clean --minify --dts",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src"
  },
  "keywords": [
    "ecs",
    "game-engine",
    "typescript",
    "wasd"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.4.1",
    "tinyglobby": "^0.2.17",
    "tsup": "^8.5.1",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "nanoid": "^5.1.16"
  },
  "eslintConfig": {
    "root": true,
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended"
    ],
    "env": {
      "node": true
    }
  }
}

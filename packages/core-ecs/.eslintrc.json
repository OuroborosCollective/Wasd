{
  "extends": ["../../.eslintrc.json"],
  "ignorePatterns": ["!**/*"],
  "overrides": [
    {
      "files": ["*.ts", "*.tsx"],
      "parser": "@typescript-eslint/parser",
      "parserOptions": {
        "project": ["packages/core-ecs/tsconfig.json"],
        "tsconfigRootDir": "."
      },
      "rules": {
        "@typescript-eslint/no-explicit-any": "warn",
        "no-console": "warn"
      }
    },
    {
      "files": ["*.js", "*.jsx"],
      "rules": {
        "no-console": "warn"
      }
    }
  ]
}
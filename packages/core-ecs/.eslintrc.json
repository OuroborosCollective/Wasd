{
  "root": false,
  "ignorePatterns": [
    "!**/*"
  ],
  "extends": [
    "../../.eslintrc.json"
  ],
  "overrides": [
    {
      "files": [
        "*.ts",
        "*.tsx"
      ],
      "parser": "@typescript-eslint/parser",
      "parserOptions": {
        "project": [
          "packages/core-ecs/tsconfig.json"
        ],
        "sourceType": "module",
        "ecmaVersion": 2020
      },
      "rules": {
        "@typescript-eslint/no-explicit-any": "warn",
        "no-console": "warn"
      }
    },
    {
      "files": [
        "*.js",
        "*.jsx"
      ],
      "rules": {
        "no-console": "warn"
      }
    }
  ]
}
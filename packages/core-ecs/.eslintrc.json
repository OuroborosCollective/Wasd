{
  "root": false,
  "ignorePatterns": [
    "!**/*"
  ],
  "extends": [
    "../../.eslintrc.json"
  ],
  "overrides": [
    {
      "files": [
        "*.ts",
        "*.tsx",
        "*.js",
        "*.jsx"
      ],
      "rules": {
        "@typescript-eslint/no-explicit-any": "warn",
        "no-console": "warn"
      }
    },
    {
      "files": [
        "*.ts",
        "*.tsx"
      ],
      "parserOptions": {
        "project": [
          "packages/core-ecs/tsconfig.json"
        ]
      }
    }
  ]
}
{
  "name": "@wasd/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./items": {
      "types": "./dist/items/index.d.ts",
      "import": "./dist/items/index.js"
    },
    "./items/types": {
      "types": "./dist/items/types.d.ts",
      "import": "./dist/items/types.js"
    },
    "./items/itemSignature": {
      "types": "./dist/items/itemSignature.d.ts",
      "import": "./dist/items/itemSignature.js"
    }
  },
  "scripts": {
    "build": "node scripts/transpile-build.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "eventemitter3": "^5.0.4",
    "ioredis": "^5.11.0",
    "nanoid": "^5.1.16",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babylonjs/core": "^9.15.0",
    "@types/node": "^22.20.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "typescript": "^5.8.0"
  }
}

# Local player persistence (file fallback when Firestore is off)
/data/

# Local self-heal / automation state (not part of the app)
.selfhealing/

test-results/
playwright-report/
dgcc-artifacts/
node_modules/
dist/
# Optional published content snapshot (scripts/publish-content-pack.mjs)
published-content/current/

# Generated by scripts/sync-world-assets.mjs (source of truth: repo-root world-assets/)
client/public/world-assets/
client/public/assets/models/world-assets/
.env
.env.local
# VPS-style secrets (never commit Firebase Admin JSON)
secrets/
**/firebase-adminsdk*.json
.DS_Store
*.log
# Transpiled stray output next to shared TS sources (do not commit)
shared/*.js
coverage/server/firebase-applet-config.json

# SpacetimeDB Rust module build output
spacetimedb-modules/**/target/
spacetimedb-modules/**/Cargo.lock

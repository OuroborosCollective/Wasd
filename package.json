{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo Root Configuration",
  "workspaces": [
    "packages/*",
    "apps/*",
    "projects/*",
    "server",
    "client",
    "shared",
    "engine",
    "portal"
  ],
  "scripts": {
    "test": "pnpm --recursive run test",
    "lint": "pnpm --recursive run lint",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' pnpm --recursive run build",
    "quality-check": "pnpm run lint && pnpm run test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
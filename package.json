{
  "name": "@arelororian/monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "build": "pnpm -r build",
    "build:web": "pnpm -r --filter @wasd/web build",
    "build:2d": "pnpm -r --filter @wasd/client-2d build",
    "build:3d": "pnpm -r --filter @wasd/client build",
    "dev:web": "pnpm -r --filter @wasd/web dev",
    "dev:2d": "pnpm -r --filter @wasd/client-2d dev",
    "dev:3d": "pnpm -r --filter @wasd/client dev",
    "dev:all": "concurrently \"pnpm dev:2d\" \"pnpm dev:3d\" \"pnpm dev:web\"",
    "build:all": "pnpm build:2d && pnpm build:3d && pnpm build:web",
    "guard:monorepo": "node scripts/monorepo-guard.mjs",
    "guard:monorepo:frozen": "MONOREPO_GUARD_RUN_PNPM=1 node scripts/monorepo-guard.mjs",
    "guard:architecture": "node scripts/arelorian-architecture-lint.mjs",
    "guard:all": "pnpm guard:monorepo && pnpm guard:architecture",
    "clean": "pnpm -r exec rm -rf dist node_modules"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "concurrently": "^9.2.1",
    "eslint": "^10.4.0",
    "pnpm": "^11.2.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "@google/genai",
      "@nestjs/core",
      "@prisma/engines",
      "cpu-features",
      "esbuild",
      "pg",
      "prisma",
      "protobufjs",
      "sharp",
      "ssh2"
    ],
    "overrides": {
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3",
      "@types/node": "^25.9.1",
      "typescript": "^6.0.3",
      "zod": "^4.4.3",
      "three": "0.184.0",
      "@babylonjs/core": "9.8.0",
      "@babylonjs/materials": "9.8.0",
      "@babylonjs/loaders": "9.8.0",
      "react": "^19.2.6",
      "socket.io-client": "^4.8.3",
      "pg": "^8.20.0"
    },
    "resolutions": {
      "typescript": "^6.0.3",
      "@types/node": "^25.9.1"
    }
  }
}

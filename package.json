{
  "name": "@arelororian/monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:network": "pnpm --filter @arelorian/core-network build",
    "build:2d": "pnpm --filter @arelorian/client-2d build",
    "dev:2d": "pnpm --filter @arelorian/client-2d dev",
    "dev:all": "concurrently \"pnpm dev:2d\" \"pnpm --filter @wasd/client dev\"",
    "install": "pnpm install -r"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

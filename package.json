{
  "name": "@arelororian/monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dgcc": "pnpm exec tsx tools/dgcc/run-dgcc.ts",
    "dgcc:extreme": "pnpm exec tsx tools/dgcc/run-dgcc.ts --mode=extreme",
    "lint": "eslint server/src client/src",
    "test": "vitest run",
    "test:dgcc": "vitest run --passWithNoTests server/src/tests/validate-content-core.test.ts server/src/tests/interaction.test.ts server/src/tests/audit-content-model-paths.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ci": "CI=1 playwright test",
    "test:e2e:install": "playwright install chromium",
    "check:interact": "node scripts/check-interact-consistency.mjs",
    "validate": "vitest run server/src/tests/validate-content-core.test.ts",
    "audit:model-paths": "pnpm exec tsx server/src/tools/auditModelPaths.ts",
    "ci:verify": "pnpm run lint && pnpm run test && pnpm run check:interact",
    "build": "pnpm -r build",
    "build:network": "pnpm -r --filter @arelorian/core-network build",
    "build:2d": "pnpm -r --filter @arelorian/client-2d build",
    "build:3d": "pnpm -r --filter @wasd/client build",
    "dev:network": "pnpm -r --filter @arelorian/core-network dev",
    "dev:2d": "pnpm -r --filter @arelorian/client-2d dev",
    "dev:3d": "pnpm -r --filter @wasd/client dev",
    "dev:all": "concurrently \"pnpm dev:network\" \"pnpm dev:2d\" \"pnpm dev:3d\"",
    "build:all": "pnpm build:network && pnpm build:2d && pnpm build:3d",
    "clean": "pnpm -r exec rm -rf dist node_modules"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^25.7.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "pnpm": "^11.1.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "pg",
      "@prisma/engines",
      "protobufjs",
      "cpu-features",
      "ssh2"
    ],
    "overrides": {
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3",
      "@types/node": "^25.7.0",
      "typescript": "^6.0.3",
      "zod": "^4.4.3",
      "three": "0.184.0",
      "@babylonjs/core": "^9.6.2",
      "@babylonjs/materials": "^9.6.2",
      "@babylonjs/loaders": "^9.6.2",
      "react": "^19.2.6",
      "socket.io-client": "^4.8.3",
      "pg": "^8.20.0"
    },
    "resolutions": {
      "typescript": "^6.0.3",
      "@types/node": "^25.7.0"
    }
  }
}
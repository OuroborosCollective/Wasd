{
  "name": "@arelororian/monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "build": "pnpm -r build",
    "build:web": "pnpm -r --filter @wasd/web build",
    "build:2d": "pnpm -r --filter @wasd/client-2d build",
    "build:3d": "pnpm -r --filter @wasd/client build",
    "dev:web": "pnpm -r --filter @wasd/web dev",
    "dev:2d": "pnpm -r --filter @wasd/client-2d dev",
    "dev:3d": "pnpm -r --filter @wasd/client dev",
    "dev:all": "concurrently \"pnpm dev:2d\" \"pnpm dev:3d\" \"pnpm dev:web\"",
    "build:all": "pnpm build:2d && pnpm build:3d && pnpm build:web",
    "assets:pixi:scan-inbox": "node scripts/scan-pixi-asset-inbox.mjs",
    "assets:pixi:plan": "node scripts/import-pixi-dev-hub-assets.mjs --dry-run",
    "assets:pixi:prepare": "node scripts/import-pixi-dev-hub-assets.mjs",
    "assets:pixi:import:kenney-ui": "node scripts/import-kenney-ui-pack.mjs",
    "assets:pixi:import:kenney-ui:dry-run": "node scripts/import-kenney-ui-pack.mjs --dry-run",
    "assets:pixi:validate": "node scripts/validate-pixi-assets.mjs",
    "assets:pixi:validate-batches": "node scripts/validate-pixi-import-batches.mjs",
    "assets:stitch:intake": "python3 scripts/stitch_atlas_intake.py",
    "assets:stitch:intake:zip": "python3 scripts/stitch_atlas_intake.py --input",
    "assets:stitch:validate": "python3 scripts/__tests__/stitch_atlas_intake.test.py",
    "guard:monorepo": "node scripts/monorepo-guard.mjs",
    "guard:monorepo:frozen": "MONOREPO_GUARD_RUN_PNPM=1 node scripts/monorepo-guard.mjs",
    "guard:architecture": "node scripts/arelorian-architecture-lint.mjs",
    "guard:worldtick": "pnpm --filter @wasd/server guard:worldtick",
    "guard:entrypoints": "node scripts/verify-client-entrypoints.mjs",
    "guard:deploy-2d-first": "node scripts/test-deploy-2d-first-readiness.mjs",
    "guard:all": "pnpm guard:monorepo && pnpm guard:architecture && pnpm guard:worldtick && pnpm guard:entrypoints && pnpm guard:deploy-2d-first && pnpm audit:core-alignment",
    "migration:aurion:source-ledger": "node scripts/build-wasd-aurion-source-ledger.mjs",
    "audit:core-alignment": "node scripts/audit-core-reality-alignment.mjs",
    "audit:core-alignment:fail": "node scripts/audit-core-reality-alignment.mjs --fail",
    "audit:release-state": "node scripts/audit-areloria-release-state.mjs",
    "audit:release-state:json": "node scripts/audit-areloria-release-state.mjs --json",
    "audit:release-state:fail": "node scripts/audit-areloria-release-state.mjs --fail",
    "modules:scan": "node scripts/analyze-modules.mjs --verbose",
    "modules:scan:ci": "node scripts/analyze-modules.mjs --ci --verbose --fail-on=D,E",
    "modules:fix:dry": "node scripts/autofix-modules.mjs --manifest",
    "modules:fix": "node scripts/autofix-modules.mjs --write --manifest",
    "modules:fix:headers": "node scripts/autofix-modules.mjs --write --manifest --headers",
    "autoheal:plan": "node scripts/autoheal-modules.mjs --plan",
    "autoheal:plan:verbose": "node scripts/autoheal-modules.mjs --plan --verbose",
    "autoheal:apply": "node scripts/autoheal-modules.mjs --apply --max-risk=SAFE_MECHANICAL",
    "autoheal:apply:low": "node scripts/autoheal-modules.mjs --apply --max-risk=LOW_SEMANTIC",
    "clean": "pnpm -r exec rm -rf dist node_modules"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "concurrently": "^10.0.4",
    "eslint": "^9.0.0",
    "jsdom": "^29.1.1",
    "pnpm": "^11.20.0",
    "sharp": "^0.35.3",
    "typescript": "^5.8.0",
    "vitest": "^2.0.0",
    "ws": "^8.21.3"
  }
}

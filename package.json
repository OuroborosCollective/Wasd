{
  "name": "areloria-wasd",
  "version": "1.0.0",
  "private": true,
  "description": "Areloria WASD Monorepo - High-performance 3D RPG & Metaverse Platform",
  "packageManager": "pnpm@9.12.2",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "build": "pnpm -r run build",
    "quality-check": "pnpm run lint && pnpm run test",
    "deploy": "bash scripts/deploy-vps.sh",
    "typecheck": "pnpm -r run typecheck"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.18",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.3.0",
    "eslint-config-next": "^16.2.6",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0",
      "@types/node": "^22.19.18",
      "typescript": "^6.0.3"
    }
  }
}

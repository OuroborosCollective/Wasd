{
  "name": "@arelororian/monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint server/src client/src",
    "test": "vitest run",
    "validate": "pnpm --prefix server run validate",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e": "pnpm --prefix server run build && playwright test",
    "test:e2e:ci": "playwright install chromium && pnpm --prefix server run build && CI=true playwright test",
    "check:interact": "node scripts/check-interact-consistency.mjs",
    "ci:verify": "pnpm run lint && pnpm run test",
    "dgcc": "tsx tools/dgcc/run-dgcc.ts",
    "dgcc:extreme": "tsx tools/dgcc/run-dgcc.ts --mode=extreme",
    "build": "pnpm -r build",
    "build:web": "pnpm -r --filter @wasd/web build",
    "build:2d": "pnpm -r --filter @wasd/client-2d build",
    "build:3d": "pnpm -r --filter @wasd/client build",
    "dev:web": "pnpm -r --filter @wasd/web dev",
    "dev:2d": "pnpm -r --filter @wasd/client-2d dev",
    "dev:3d": "pnpm -r --filter @wasd/client dev",
    "dev:all": "concurrently \"pnpm dev:2d\" \"pnpm dev:3d\" \"pnpm dev:web\"",
    "build:all": "pnpm build:2d && pnpm build:3d && pnpm build:web",
    "guard:monorepo": "node scripts/monorepo-guard.mjs",
    "guard:monorepo:frozen": "MONOREPO_GUARD_RUN_PNPM=1 node scripts/monorepo-guard.mjs",
    "clean": "pnpm -r exec rm -rf dist node_modules"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^25.9.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "pnpm": "^11.1.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "pg",
      "@prisma/engines",
      "protobufjs",
      "cpu-features",
      "ssh2"
    ],
    "overrides": {
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3",
      "@types/node": "^25.9.0",
      "typescript": "^6.0.3",
      "zod": "^4.4.3",
      "three": "0.184.0",
      "@babylonjs/core": "^9.6.2",
      "@babylonjs/materials": "^9.6.2",
      "@babylonjs/loaders": "^9.6.2",
      "react": "^19.2.6",
      "socket.io-client": "^4.8.3",
      "pg": "^8.20.0"
    },
    "resolutions": {
      "typescript": "^6.0.3",
      "@types/node": "^25.9.0"
    }
  }
}

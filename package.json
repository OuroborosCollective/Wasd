{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo Root Configuration",
  "packageManager": "pnpm@9.1.0",
  "workspaces": [
    "client",
    "server",
    "shared",
    "engine",
    "portal",
    "apps/*",
    "projects/*",
    "packages/*"
  ],
  "scripts": {
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "build": "pnpm -r run build",
    "quality-check": "pnpm run lint && pnpm run test",
    "deploy": "bash scripts/deploy-vps.sh"
  },
  "engines": {
    "node": "^20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "eslint": "^10.3.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.2.4",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "autoprefixer": "^10.5.0",
    "eslint-config-next": "^16.2.4",
    "next": "^16.2.4",
    "postcss": "^8.5.13",
    "tailwindcss": "^4.2.4"
  }
}
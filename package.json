{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo Root Configuration",
  "packageManager": "pnpm@9.1.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "projects/*",
    "server",
    "client",
    "shared",
    "engine",
    "portal"
  ],
  "scripts": {
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "build": "pnpm -r run build",
    "quality-check": "pnpm run lint && pnpm run test",
    "deploy": "bash scripts/deploy-vps.sh"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
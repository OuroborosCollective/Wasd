{
  "name": "areloria-wasd",
  "version": "1.0.0",
  "private": true,
  "description": "Areloria WASD Monorepo - High-performance 3D RPG & Metaverse Platform",
  "packageManager": "pnpm@9.12.2",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "build": "pnpm -r run build",
    "quality-check": "pnpm run lint && pnpm run test",
    "deploy": "bash scripts/deploy-vps.sh",
    "dgcc": "pnpm exec tsx tools/dgcc/run-dgcc.ts --mode=minimal",
    "dgcc:extreme": "pnpm exec tsx tools/dgcc/run-dgcc.ts --mode=extreme",
    "test:e2e": "pnpm exec playwright test",
    "test:e2e:ci": "node scripts/e2e-ci.mjs",
    "test:e2e:install": "playwright install chromium"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "tsx": "^4.19.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.4",
    "typescript": "^5.7.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "18.3.12",
      "@types/react-dom": "18.3.1"
    }
  }
}

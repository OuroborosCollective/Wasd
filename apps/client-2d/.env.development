# Areloria Client Development Environment
# Copy to .env and fill in values

# Client mode: development | staging | production
VITE_ARELORIA_MODE=development

# WebSocket URL for game server (local dev)
# IMPORTANT: Server listens on PORT (default 3000), not 3001
VITE_WS_URL=ws://localhost:3000/ws

# Health check endpoint (local dev)
VITE_HEALTH_URL=http://localhost:3000/health
{
  "name": "@wasd/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "dev": "vite",
    "build": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc && node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build --debug --logLevel info",
    "preview": "vite preview",
    "check-types": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest --passWithNoTests",
    "test:ci": "vitest --passWithNoTests run",
    "test:coverage": "vitest --passWithNoTests run --coverage"
  },
  "dependencies": {
    "@babylonjs/core": "^9.10.1",
    "@babylonjs/loaders": "^9.10.1",
    "@babylonjs/materials": "^9.10.1",
    "@wasd/database": "workspace:*",
    "@wasd/shared": "workspace:*",
    "@wasd/types": "workspace:*",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "0.184.0",
    "tslib": "^2.8.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.184.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "8.0.14",
    "vitest": "^4.1.8"
  }
}

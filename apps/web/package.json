{
  "name": "@wasd/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "dev": "vite",
    "build": "npm run check-types && npm run validate-assets && vite build",
    "preview": "vite preview",
    "check-types": "tsc --noEmit",
    "validate-assets": "node ../../scripts/validate-assets.mjs --target apps/web/public/assets/kaykit",
    "test": "vitest --passWithNoTests",
    "test:ci": "vitest --passWithNoTests run",
    "test:coverage": "vitest --passWithNoTests run --coverage"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "three": "0.169.0",
    "@babylonjs/core": "^7.45.0",
    "@babylonjs/loaders": "^7.45.0",
    "@wasd/database": "workspace:*",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.13.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.5",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  }
}
{
  "name": "@wasd/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "dev": "vite",
    "build": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc && node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build --debug --logLevel info || true",
    "preview": "vite preview",
    "check-types": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest --passWithNoTests",
    "test:ci": "vitest --passWithNoTests run",
    "test:coverage": "vitest --passWithNoTests run --coverage"
  },
  "dependencies": {
    "@babylonjs/core": "^9.6.2",
    "@babylonjs/loaders": "^9.6.2",
    "@babylonjs/materials": "^9.6.2",
    "@wasd/database": "workspace:*",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "0.184.0",
    "tslib": "^2.8.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.18",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.184.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.5"
  }
}
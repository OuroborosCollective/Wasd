{
  "name": "@wasd/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "dev": "vite",
    "build": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc && node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build --debug --logLevel info",
    "preview": "vite preview",
    "check-types": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest --passWithNoTests",
    "test:ci": "vitest --passWithNoTests run",
    "test:coverage": "vitest --passWithNoTests run --coverage"
  },
  "dependencies": {
    "@babylonjs/core": "^9.20.1",
    "@babylonjs/loaders": "^9.20.1",
    "@babylonjs/materials": "^9.20.1",
    "@wasd/database": "workspace:*",
    "@wasd/shared": "workspace:*",
    "@wasd/types": "workspace:*",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "0.185.1",
    "tslib": "^2.8.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.0",
    "vite": "8.0.16",
    "vitest": "^4.1.8"
  }
}

{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "rootDir": "./src",
    "baseUrl": ".",
    "outDir": "../../dist/apps/api",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "paths": {
      "@wasd/utils": ["../../packages/utils/src"],
      "@wasd/utils/*": ["../../packages/utils/src/*"],
      "@areloria/shared-types": ["../../packages/shared-types/src"],
      "@areloria/shared-types/*": ["../../packages/shared-types/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "moduleResolution": "node",
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "../../dist/apps/api",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true, "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "paths": {
      "@wasd/utils": ["../../packages/utils/src"],
      "@wasd/utils/*": ["../../packages/utils/src/*"],
      "@areloria/shared-types": ["../../packages/shared-types/src"],
      "@areloria/shared-types/*": ["../../packages/shared-types/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*.spec.ts",
    "**/*.test.ts",
    "jest.config.ts"
  ],
  "references": [
    {
      "path": "../../packages/utils"
    },
    {
      "path": "../../packages/shared-types"
    }
  ]
}
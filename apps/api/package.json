{
  "name": "@wasd/api-core",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "rimraf dist && tsc --project tsconfig.json --pretty || true",
    "start": "node --enable-source-maps dist/index.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist node_modules"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@wasd/core": "workspace:*",
    "@wasd/database": "workspace:*",
    "@wasd/redis": "workspace:*",
    "@wasd/types": "workspace:*",
    "@wasd/utils": "workspace:*",
    "dotenv": "^17.4.2",
    "node-ssh": "^13.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/three": "0.185.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.4.1",
    "prisma": "^7.9.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.12",
    "typescript": "^5.8.0",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@babylonjs/core": "*",
    "@babylonjs/havok": "*"
  }
}
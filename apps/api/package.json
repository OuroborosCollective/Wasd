{
  "name": "@wasd/api-core",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "rimraf dist && tsc --project tsconfig.json --pretty",
    "start": "node --enable-source-maps dist/index.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist node_modules"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.10",
    "@nestjs/core": "^11.0.10",
    "@nestjs/platform-express": "^11.0.10",
    "@wasd/core": "workspace:*",
    "@wasd/database": "workspace:*",
    "@wasd/redis": "workspace:*",
    "@wasd/types": "workspace:*",
    "@wasd/utils": "workspace:*",
    "dotenv": "^16.4.7",
    "node-ssh": "^13.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.1",
    "@types/three": "0.169.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^8.57.0",
    "prisma": "^7.8.0",
    "rimraf": "^5.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "@babylonjs/core": "*",
    "@babylonjs/havok": "*"
  }
}
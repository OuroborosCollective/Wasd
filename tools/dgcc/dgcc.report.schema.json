{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DGCC Report",
  "type": "object",
  "required": ["startedAt", "finishedAt", "mode", "ok", "checks", "inconsistencies", "fixes", "artifacts"],
  "properties": {
    "startedAt": { "type": "string" },
    "finishedAt": { "type": "string" },
    "mode": { "type": "string" },
    "ok": { "type": "boolean" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "ok", "durationMs"],
        "properties": {
          "name": { "type": "string" },
          "ok": { "type": "boolean" },
          "durationMs": { "type": "number" },
          "summary": { "type": "string" }
        }
      }
    },
    "inconsistencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "severity", "message"],
        "properties": {
          "category": { "type": "string" },
          "severity": { "type": "string", "enum": ["info", "warn", "error"] },
          "message": { "type": "string" },
          "file": { "type": "string" },
          "hint": { "type": "string" }
        }
      }
    },
    "fixes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "message"],
        "properties": {
          "kind": { "type": "string" },
          "message": { "type": "string" },
          "file": { "type": "string" }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}

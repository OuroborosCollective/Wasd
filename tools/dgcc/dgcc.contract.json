{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "DGCC (Design+Gameplay Consistency Contract)",
  "version": 1,
  "modes": {
    "minimal": {
      "fix": { "enabled": false },
      "checks": [
        "lint",
        "unit",
        "checkInteract",
        "contentValidate",
        "serverBuild",
        "clientBuild",
        "e2e",
        "assetsAudit",
        "wsSchemaSmoke",
        "uiA11ySmoke"
      ]
    },
    "extreme": {
      "fix": { "enabled": true, "allowDangerous": true },
      "checks": [
        "lint",
        "unit",
        "checkInteract",
        "contentValidate",
        "serverBuild",
        "clientBuild",
        "e2e",
        "assetsAudit",
        "wsSchemaSmoke",
        "uiA11ySmoke"
      ]
    }
  },
  "rules": {
    "auth": {
      "requiredLoginErrors": ["invalid_token", "login_required"]
    },
    "ws": {
      "maxMessageBytesEnv": "WS_MAX_MESSAGE_BYTES",
      "requireWelcomeStatsShape": true
    },
    "content": {
      "validateOnBuild": true
    },
    "assets": {
      "clientModelsDir": "client/public/assets/models",
      "mustHaveSubfolders": ["characters", "monsters", "objects"],
      "worldAssetsDir": "world-assets",
      "allowedExt": [".glb", ".gltf", ".bin", ".png", ".jpg", ".jpeg", ".webp", ".ktx2"]
    },
    "ui": {
      "requireAriaLabelsOnButtons": true,
      "requireTitleOnIconButtons": true
    }
  }
}

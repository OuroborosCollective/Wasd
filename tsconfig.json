{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "incremental": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": false
  },
  "files": [],
  "references": [
    { "path": "client" },
    { "path": "server" },
    { "path": "shared" },
    { "path": "packages/core" },
    { "path": "packages/shared" },
    { "path": "projects/eco-trader" }
  ]
}
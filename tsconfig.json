{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "incremental": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": false,
    "noImplicitAny": false
  },
  "files": [],
  "references": [
    { "path": "client" },
    { "path": "server" },
    { "path": "engine" },
    { "path": "packages/core" },
    { "path": "packages/core-logic" },
    { "path": "packages/shared" },
    { "path": "packages/core-ecs" },
    { "path": "packages/ui" },
    { "path": "packages/spatial-hub" },
    { "path": "packages/rendering-bridge" },
    { "path": "apps/api" },
    { "path": "apps/web" },
    { "path": "projects/eco-trader" }
  ]
}
